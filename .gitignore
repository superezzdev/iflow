# ==============================================================================
# MindPost Monorepo - Comprehensive Git Ignore Configuration
# ==============================================================================

# --- Dependencies & Package Managers ---
node_modules/
.pnpm-store/
.npm/
.yarn/
jspm_packages/
web_modules/

# --- Build Outputs & Bundlers ---
dist/
dist-ssr/
build/
out/
.output/
.wxt/
.next/
*.tsbuildinfo
.turbo/
.vercel/

# --- Extension Artifacts ---
*.zip
*.crx
*.xpi

# --- Environment & Secret Files ---
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
# Explicitly track documented example environment files:
!.env.example
!.env.*.example

# --- Logs & Runtime Output ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Database & Prisma ---
*.sqlite
*.sqlite3
*.db
*.db-journal
packages/database/src/generated/

# --- Testing & Coverage ---
coverage/
.nyc_output/
playwright-report/
test-results/
.vitest-cache/

# --- IDE & Editor Specific ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swp
*.sublime-project
*.sublime-workspace

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- Temporary & Scratch Files ---
.cache/
.temp/
.tmp/
tmp/
scratch/
