# ==============================================================================
# MindPost Monorepo - Environment Variables Example
# ==============================================================================
# Copy this file to .env or .env.local and populate the values for your environment.

# ------------------------------------------------------------------------------
# 1. Database Configuration (used in packages/database, apps/api, apps/web)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mindpost_dev?schema=public

# Direct URL for Prisma migrations (if using PgBouncer/connection pooler)
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/mindpost_dev?schema=public

# ------------------------------------------------------------------------------
# 2. Development Session / Auth Abstraction
# ------------------------------------------------------------------------------
# Default development user ID used for local testing without OAuth
DEV_USER_ID=dev-user-001

# ------------------------------------------------------------------------------
# 3. API Service Configuration (apps/api)
# ------------------------------------------------------------------------------
# Port for the API server
API_PORT=3001
API_URL=http://localhost:3001

# Allowed CORS origins (comma-separated, include extension origin and web dashboard)
CORS_ALLOWED_ORIGINS=http://localhost:3000,chrome-extension://*

# ------------------------------------------------------------------------------
# 4. AI Provider Configuration (used in packages/ai, apps/api)
# ------------------------------------------------------------------------------
# Active AI provider for insight extraction and LinkedIn post generation
# Supported in Phase 1: openai
# Future supported: gemini, claude
AI_PROVIDER=openai

# OpenAI API Key (Required when AI_PROVIDER=openai)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Optional: Custom OpenAI Model (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# Optional: Custom OpenAI Base URL (e.g. for proxies or Azure OpenAI)
# OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 5. Web Dashboard Configuration (apps/web)
# ------------------------------------------------------------------------------
# Port for the Web dashboard
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ------------------------------------------------------------------------------
# 6. Extension Configuration (apps/extension)
# ------------------------------------------------------------------------------
# Base URL of the API used by the browser extension
WXT_PUBLIC_API_URL=http://localhost:3001/api
