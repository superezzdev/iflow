datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Conversation {
  id            String       @id @default(cuid())
  source        String       @default("chatgpt") // 'chatgpt', 'claude', 'gemini'
  title         String
  url           String?
  totalMessages Int          @default(0)
  messages      Json         // Normalized array of ChatMessage
  metadata      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  insights      Insight[]
  posts         SocialPost[]

  @@index([createdAt])
  @@index([source])
}

model Insight {
  id                    String       @id @default(cuid())
  conversationId        String
  conversation          Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  title                 String
  coreIdea              String
  keyTakeaways          Json         // KeyTakeaway[]
  practicalApplications Json         // string[]
  suggestedHooks        Json         // string[]
  tags                  String[]     @default([])
  suggestedTone         String?
  createdAt             DateTime     @default(now())

  posts                 SocialPost[]

  @@index([conversationId])
  @@index([createdAt])
}

model SocialPost {
  id               String        @id @default(cuid())
  conversationId   String
  conversation     Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  insightId        String?
  insight          Insight?      @relation(fields: [insightId], references: [id], onDelete: SetNull)
  platform         String        @default("linkedin") // 'linkedin', 'x', 'threads'
  hook             String
  body             String
  callToAction     String?
  hashtags         String[]      @default([])
  formattedContent String
  status           String        @default("draft") // 'draft', 'review', 'approved', 'rejected'
  characterCount   Int           @default(0)
  metadata         Json?
  approvedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([conversationId])
  @@index([platform])
  @@index([status])
  @@index([createdAt])
}
